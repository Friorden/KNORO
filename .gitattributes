# Normalize line endings so Windows/macOS/Linux teammates
# don't produce whole-file diffs on every commit.
* text=auto eol=lf

# Binary assets: never line-ending-converted, never text-diffed.
*.png   binary
*.jpg   binary
*.wav   binary
*.ogg   binary
*.ttf   binary
*.woff2 binary
*.zip   binary
*.rar   binary
*.exe   binary
