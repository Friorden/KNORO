class_name Menus
extends RefCounted
## Modal menus shared by the title screen and the in-game pause menu:
## pause, save / load slots, settings, how to play, credits.
## Each opens on top of `parent` (dimmed backdrop + parchment panel) and frees
## itself when closed; `closed` callbacks let the caller refresh.

const HELP := [
	["The goal", "You are the Champion of one of the kingdoms. Turn a small settlement into a living kingdom while your neighbours do the same.\n\nThere is no single way to win: grow your capital, explore, fight, trade, make friends and enemies. The main quest (J) gives you a thread to follow."],
	["Each day", "1. Roll the die (Space): 1D6 + your DEX bonus = moves today.\n2. Walk: hover a hex to see the route and its cost, click to go. Colours show danger (green safe, yellow uncertain, red wild).\n3. Things happen on the road: events, travellers, beasts, bandits.\n4. End the day (Enter). Buildings produce, people eat, patrols move. Every 7 days you get a week report."],
	["Cargo", "Loot and gifts go into your Champion's cargo, not straight to the kingdom. They arrive when you walk into your capital. If the Champion falls, the cargo is lost. Road costs (tolls, bribes) are paid from the cargo."],
	["The city", "C or the City button opens your capital. Pick a building on the right, glowing plots accept it, click to build.\nClick a building to upgrade it; at level 3 you choose a specialisation. Some buildings switch production modes, some make items every week (they wait in the storehouse until you are home).\nClaim more land with Expand; clear woods, hills and ponds to build on them.\nResources: food, wood, stone, gold and iron. Iron comes from an iron outpost, the foundry, the harbour or some specialisations."],
	["Ages", "Settlement → Town → City. Each age needs buildings, people and a payment, and unlocks new buildings, more builds a day, better gear and more land."],
	["Battles", "Two lines face each other; rank 1 is in front. Each skill shows which of YOUR ranks can use it and which of THEIR ranks it reaches (the dots). Pick a skill (1–3), then a glowing target.\nMove swaps you with a neighbour. Items use a potion or a bomb. Retreat is a DEX roll and costs the day. The fallen are gone for good."],
	["Your Champion", "Six attributes: STR (strength), DEX (dexterity), CON (constitution), INT (intelligence), WIS (wisdom), CHA (charisma). Checks roll a D20 (twenty-sided die) + the attribute against a DC (difficulty class).\nI opens the bag: weapon, armour and trinket slots plus 8 bag slots. Gear raises attributes, defence, damage or moves."],
	["Quests & dungeons", "J opens the quest log. The main quest leads through the story; side quests come from people and places.\nCaves and dungeons are marked on the map. Walk in to delve: a string of rooms with fights, traps, chests and shrines, and a guardian at the end. You can leave between rooms."],
	["Controls", "Space roll · Enter end day · C city · I bag · J quests · Esc menu\nDrag or WASD / arrows to pan · + / − zoom (the mouse wheel is ignored on purpose)\nM music on/off · N sounds on/off · F11 fullscreen"],
]

const CREDITS := "KNORO — a game by Friorden.\n\nArt\n• Tiny Swords, Kings and Pigs, Pirate Bomb, Treasure Hunters — Pixel Frog (pixelfrog-assets.itch.io)\n• Monster battlers — Robert Pinero (robertpinero.itch.io)\n• Mountain Dusk, Parallax Forest, Caverns — Luis Zuno / ansimuz (ansimuz.itch.io)\n• Crystal cave backgrounds — CraftPix.net\n• RPG Arsenal icons — LimeZu (limezu.itch.io)\n• Goblin's Arsenal icons — Goblin's Archive (goblin-enjoyer.itch.io)\n\nFonts\n• Pixelify Sans, Nunito — SIL Open Font License\n\nSound and music are generated by the game's own tools.\nEngine: Godot 4."


static func _frame(parent: Node, title: String, w: float = 760, h: float = 0) -> Array:
	var root := Control.new()
	root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.mouse_filter = Control.MOUSE_FILTER_STOP
	var dim := ColorRect.new()
	dim.color = Color(0.08, 0.05, 0.14, 0.62)
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.add_child(dim)
	var center := CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.add_child(center)
	var panel := PanelContainer.new()
	panel.add_theme_stylebox_override("panel", PixelUI.box("nine_paper", Vector4(40, 32, 40, 34)))
	panel.custom_minimum_size = Vector2(w, h)
	center.add_child(panel)
	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 14)
	panel.add_child(col)
	var head := HBoxContainer.new()
	head.add_child(PixelUI.title(title, 36))
	var sp := Control.new()
	sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	head.add_child(sp)
	var x := PixelUI.button("✕", "red", 18)
	x.custom_minimum_size = Vector2(48, 44)
	x.pressed.connect(root.queue_free)
	head.add_child(x)
	col.add_child(head)
	parent.add_child(root)
	panel.scale = Vector2(0.94, 0.94)
	panel.pivot_offset = Vector2(w / 2.0, 200)
	panel.create_tween().tween_property(panel, "scale", Vector2.ONE, 0.16).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	Audio.play("paper", -4.0)
	return [root, col]


static func _cta(col: Node, text: String, kind: String, fn: Callable) -> Button:
	var b := PixelUI.button(text, kind, 22)
	b.custom_minimum_size = Vector2(0, 58)
	b.pressed.connect(fn)
	col.add_child(b)
	return b


# ------------------------------------------------------------------ pause

static func pause(parent: Node, on_close: Callable = Callable()) -> Control:
	var f := _frame(parent, "Paused", 520)
	var root: Control = f[0]
	var col: VBoxContainer = f[1]
	if on_close.is_valid():
		root.tree_exited.connect(on_close)
	_cta(col, "Resume", "blue", root.queue_free)
	_cta(col, "Save game", "paper", func(): saves(parent, "save"))
	_cta(col, "Load game", "paper", func(): saves(parent, "load"))
	_cta(col, "Quest log", "paper", func():
		root.queue_free()
		QuestLog.open(parent))
	_cta(col, "Settings", "paper", func(): settings(parent))
	_cta(col, "How to play", "paper", func(): help(parent))
	_cta(col, "Main menu", "red", func():
		if Game.state and Settings.autosave and Game.state.alive:
			SaveGame.save(Game.state, "auto")
		root.queue_free()
		Main.instance.reset_world()
		Main.go("title"))
	_cta(col, "Quit to desktop", "red", func():
		if Game.state and Settings.autosave and Game.state.alive:
			SaveGame.save(Game.state, "auto")
		parent.get_tree().quit())
	return root


# ------------------------------------------------------------------ saves

static func saves(parent: Node, mode: String) -> Control:
	var f := _frame(parent, "Save game" if mode == "save" else "Load game", 820)
	var root: Control = f[0]
	var col: VBoxContainer = f[1]
	var rebuild := func(): pass
	var list := VBoxContainer.new()
	list.add_theme_constant_override("separation", 10)
	col.add_child(list)
	rebuild = func():
		for c in list.get_children():
			c.queue_free()
		for slot in SaveGame.SLOTS:
			if mode == "save" and slot == "auto":
				continue
			var m := SaveGame.meta(slot)
			var row := PanelContainer.new()
			var sb := StyleBoxFlat.new()
			sb.bg_color = Color("#f7ecd2") if not m.is_empty() else Color("#ece0c4")
			sb.border_color = PixelUI.INK
			sb.set_border_width_all(2)
			sb.border_width_bottom = 4
			sb.set_content_margin_all(12)
			row.add_theme_stylebox_override("panel", sb)
			var h := HBoxContainer.new()
			h.add_theme_constant_override("separation", 14)
			row.add_child(h)
			var info := VBoxContainer.new()
			info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			info.add_child(PixelUI.label("Autosave" if slot == "auto" else "Slot %s" % slot, 20, PixelUI.VIOLET))
			if m.is_empty():
				info.add_child(PixelUI.label("empty", 16, PixelUI.MUTED))
			else:
				info.add_child(PixelUI.label("%s · %s Kingdom · Lv %d" % [m.get("champion", "?"), m.get("kname", "?"), int(m.get("level", 1))], 17))
				info.add_child(PixelUI.label("Week %d · Day %d · %s · %s" % [int(m.get("week", 1)), int(m.get("day", 1)), m.get("age", ""), str(m.get("time", "")).replace("T", " ")], 14, PixelUI.MUTED))
			h.add_child(info)
			var s: String = slot
			if mode == "save":
				var b := PixelUI.button("Save here", "blue", 17)
				b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				b.pressed.connect(func():
					if SaveGame.save(Game.state, s):
						Audio.play("success", -6.0)
						Main.toast("Saved to slot %s" % s)
					rebuild.call())
				h.add_child(b)
			else:
				var b := PixelUI.button("Load", "blue" if not m.is_empty() else "paper", 17)
				b.disabled = m.is_empty()
				b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				b.pressed.connect(func(): load_slot(s))
				h.add_child(b)
			if not m.is_empty():
				var d := PixelUI.button("Delete", "red", 15)
				d.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				d.pressed.connect(func():
					SaveGame.delete(s)
					rebuild.call())
				h.add_child(d)
			list.add_child(row)
	rebuild.call()
	return root


## Loads a slot and drops the player on the world map.
static func load_slot(slot: String) -> void:
	var st := SaveGame.load_into(slot)
	if st == null:
		Main.toast("That save could not be read", Style.BAD)
		return
	Game.state = st
	Game.chosen_kingdom = st.kingdom
	Main.instance.reset_world()
	Audio.play("success", -6.0)
	Main.go("world", {"from": "load"})
	Game.touch()


# ------------------------------------------------------------------ settings

static func settings(parent: Node) -> Control:
	var f := _frame(parent, "Settings", 720)
	var root: Control = f[0]
	var col: VBoxContainer = f[1]
	root.tree_exited.connect(Settings.save_cfg)
	for row in [["Master volume", "master"], ["Music", "music"], ["Sound effects", "sfx"]]:
		var h := HBoxContainer.new()
		h.add_theme_constant_override("separation", 16)
		var l := PixelUI.label(row[0], 19)
		l.custom_minimum_size = Vector2(230, 0)
		h.add_child(l)
		var sl := HSlider.new()
		sl.min_value = 0.0
		sl.max_value = 1.0
		sl.step = 0.05
		sl.value = float(Settings.get(row[1]))
		sl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		sl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		_style_slider(sl)
		var key: String = row[1]
		var pct := PixelUI.label("%d%%" % int(sl.value * 100), 18, PixelUI.MUTED)
		pct.custom_minimum_size = Vector2(64, 0)
		sl.value_changed.connect(func(v):
			Settings.set(key, v)
			Settings.apply()
			pct.text = "%d%%" % int(v * 100))
		sl.drag_ended.connect(func(_c): Audio.play("click"))
		h.add_child(sl)
		h.add_child(pct)
		col.add_child(h)
	for row in [["Fullscreen", "fullscreen"], ["Screen shake", "shake"], ["Autosave every day", "autosave"], ["First-day hints", "tips"]]:
		var h := HBoxContainer.new()
		var l := PixelUI.label(row[0], 19)
		l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		h.add_child(l)
		var key: String = row[1]
		var b := PixelUI.button("On" if Settings.get(key) else "Off", "blue" if Settings.get(key) else "paper", 17)
		b.custom_minimum_size = Vector2(110, 46)
		b.pressed.connect(func():
			Settings.set(key, not bool(Settings.get(key)))
			Settings.apply()
			b.text = "On" if Settings.get(key) else "Off"
			b.add_theme_stylebox_override("normal", PixelUI.box("btn_blue" if Settings.get(key) else "nine_paper", Vector4(16, 8, 16, 10)))
			b.add_theme_color_override("font_color", PixelUI.CREAM if Settings.get(key) else PixelUI.INK))
		h.add_child(b)
		col.add_child(h)
	var hs := HBoxContainer.new()
	hs.add_theme_constant_override("separation", 8)
	var ls := PixelUI.label("Battle speed", 19)
	ls.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	hs.add_child(ls)
	var btns: Array = []
	for sp in [1.0, 1.5, 2.0]:
		var b := PixelUI.button("×%s" % ("1" if sp == 1.0 else str(sp)), "gold" if is_equal_approx(Settings.battle_speed, sp) else "paper", 17)
		b.custom_minimum_size = Vector2(80, 46)
		btns.append([b, sp])
		hs.add_child(b)
	for pair in btns:
		var bb: Button = pair[0]
		var v: float = pair[1]
		bb.pressed.connect(func():
			Settings.battle_speed = v
			for q in btns:
				(q[0] as Button).add_theme_stylebox_override("normal", PixelUI.box("btn_hover" if is_equal_approx(float(q[1]), v) else "nine_paper", Vector4(16, 8, 16, 10))))
	col.add_child(hs)
	col.add_child(PixelUI.label("M toggles music, N toggles sounds at any time. F11 toggles fullscreen.", 14, PixelUI.MUTED))
	return root


static func _style_slider(sl: HSlider) -> void:
	var track := StyleBoxFlat.new()
	track.bg_color = Color("#c8a876")
	track.border_color = PixelUI.INK
	track.set_border_width_all(2)
	track.content_margin_top = 6
	track.content_margin_bottom = 6
	var fill := StyleBoxFlat.new()
	fill.bg_color = Color("#9a7ac9")
	fill.border_color = PixelUI.INK
	fill.set_border_width_all(2)
	fill.content_margin_top = 6
	fill.content_margin_bottom = 6
	sl.add_theme_stylebox_override("slider", track)
	sl.add_theme_stylebox_override("grabber_area", fill)
	sl.add_theme_stylebox_override("grabber_area_highlight", fill)
	var g: Texture2D = load("res://assets/tinyswords/ui/icon_03.png")
	sl.add_theme_icon_override("grabber", _scaled(g, 36))
	sl.add_theme_icon_override("grabber_highlight", _scaled(g, 40))


static func _scaled(t: Texture2D, px: int) -> Texture2D:
	var img := t.get_image()
	img.resize(px, px, Image.INTERPOLATE_NEAREST)
	return ImageTexture.create_from_image(img)


# ------------------------------------------------------------------ help & credits

static func help(parent: Node, start: int = 0) -> Control:
	var f := _frame(parent, "How to play", 1040, 640)
	var col: VBoxContainer = f[1]
	var body := HBoxContainer.new()
	body.add_theme_constant_override("separation", 18)
	body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	col.add_child(body)
	var tabs := VBoxContainer.new()
	tabs.add_theme_constant_override("separation", 6)
	tabs.custom_minimum_size = Vector2(260, 0)
	body.add_child(tabs)
	var page := VBoxContainer.new()
	page.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	body.add_child(page)
	var title := PixelUI.label("", 26, PixelUI.VIOLET)
	page.add_child(title)
	var text := PixelUI.wrap("", 18, PixelUI.INK, 600)
	text.size_flags_vertical = Control.SIZE_EXPAND_FILL
	page.add_child(text)
	var show := func(i: int):
		title.text = HELP[i][0]
		text.text = HELP[i][1]
		for k in tabs.get_child_count():
			var b: Button = tabs.get_child(k)
			b.add_theme_stylebox_override("normal", PixelUI.box("btn_hover" if k == i else "nine_paper", Vector4(16, 8, 16, 10)))
	for i in HELP.size():
		var b := PixelUI.button(HELP[i][0], "paper", 16)
		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
		var ii := i
		b.pressed.connect(func(): show.call(ii))
		tabs.add_child(b)
	show.call(start)
	return f[0]


static func credits(parent: Node) -> Control:
	var f := _frame(parent, "Credits", 860)
	var col: VBoxContainer = f[1]
	col.add_child(PixelUI.wrap(CREDITS, 17, PixelUI.INK, 760))
	return f[0]
